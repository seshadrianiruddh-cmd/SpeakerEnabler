      android:pivotY="54">
      
      <!-- Speaker body -->
      <path
          android:fillColor="#FFFFFF"
          android:pathData="M40,46 v12 h8 l8,8 v-28 l-8,8 z" />

      <!-- Inner Soundwave Arc -->
      <path
          android:strokeWidth="2.5"
          android:strokeColor="#00FFCC"
          android:strokeLineCap="round"
          android:fillColor="#00000000"
          android:pathData="M64,47 A 10,10 0 0,1 64,61" />

      <!-- Outer Soundwave Arc -->
      <path
          android:strokeWidth="2.5"
          android:strokeColor="#00FFCC"
          android:strokeLineCap="round"
          android:fillColor="#00000000"
          android:pathData="M69,42 A 17,17 0 0,1 69,66" />
